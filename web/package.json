{
  "name": "scholarhub-africa-web",
  "version": "0.1.0",
  "private": true,
  "description": "ScholarHub Africa - Next.js App Router app (Django migration target, see docs/MIGRATION_PLAN.md)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:data": "node scripts/migrate-data.mjs",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:data",
    "db:verify": "node scripts/verify-migration.mjs",
    "db:test:local": "node scripts/test-migrate-local.mjs",
    "db:test:queries": "tsx scripts/test-queries-local.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.23",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
