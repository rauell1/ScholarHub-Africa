{
  "name": "scholarhub-africa-web",
  "version": "0.1.0",
  "private": true,
  "description": "ScholarHub Africa - Next.js App Router app (Django migration target, see docs/MIGRATION_PLAN.md)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:data": "node scripts/migrate-data.mjs",
    "db:migrate:all": "npm run db:migrate && npm run db:migrate:data",
    "db:import:csv": "tsx scripts/import-scholarships-csv.ts ../scholarships_data.csv",
    "links:check": "tsx scripts/check-links.ts",
    "db:verify": "node scripts/verify-migration.mjs",
    "db:test:local": "node scripts/test-migrate-local.mjs",
    "db:test:queries": "tsx scripts/test-queries-local.ts",
    "db:studio": "drizzle-kit studio",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.12.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.24.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.36.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
