# ── ScholarHub Africa (Next.js web app) - copy to web/.env.local ──────────
# Build-safe: only SITE_* have defaults; DATABASE_URL is required at runtime
# when a page/API hits the database.

# Neon PostgreSQL - use the POOLED connection string (host ends in -pooler)
# so serverless functions share connections (docs/MIGRATION_PLAN.md §2).
# If the client rejects `channel_binding=require`, strip it and keep
# `?sslmode=require` - the migration scripts normalize this automatically.
DATABASE_URL=

# Site identity (SEO / structured data)
SITE_URL=https://scholarhub.africa
SITE_DOMAIN=scholarhub.africa
SITE_EMAIL=hello@scholarhub.africa
SITE_PHONE=+254 700 123 456
SITE_ADDRESS=Westlands, Nairobi, Kenya

# Google Analytics 4 - consent-gated (loads only after analytics consent)
GA4_MEASUREMENT_ID=

# ── Auth (NextAuth v5, JWT sessions) ───────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Vercel Cron guards (Authorization: Bearer $CRON_SECRET) ────────────────
CRON_SECRET=

# ── Resend (weekly digest) ─────────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_EMAILS=royokola3@gmail.com
DEFAULT_FROM_EMAIL=ScholarHub Africa <digest@scholarhub.africa>
