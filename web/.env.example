# ── ScholarHub Africa (Next.js web app) - copy to web/.env.local ──────────
# Build-safe: only SITE_* have defaults; DATABASE_URL is required at runtime
# when a page/API hits the database.

# Neon PostgreSQL - use the POOLED connection string (host ends in -pooler)
# so serverless functions share connections (docs/MIGRATION_PLAN.md §2).
# If the client rejects `channel_binding=require`, strip it and keep
# `?sslmode=require` - the migration scripts normalize this automatically.
DATABASE_URL=

# Site identity (SEO / structured data)
SITE_URL=https://scholarhub.africa
SITE_DOMAIN=scholarhub.africa
SITE_EMAIL=hello@scholarhub.africa
SITE_PHONE=+254 700 123 456
SITE_ADDRESS=Westlands, Nairobi, Kenya

# Google Analytics 4 - consent-gated (loads only after analytics consent)
GA4_MEASUREMENT_ID=

# ── Auth (NextAuth v5, JWT sessions) ───────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth (console.cloud.google.com → Credentials → OAuth client)
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Vercel Cron guards (Authorization: Bearer $CRON_SECRET) ────────────────
CRON_SECRET=

# ── Resend (weekly digest) ─────────────────────────────────────────────────
RESEND_API_KEY=
DIGEST_EMAILS=royokola3@gmail.com
DEFAULT_FROM_EMAIL=ScholarHub Africa <digest@scholarhub.africa>
CONTACT_EMAIL=

# ── Sentry (already wired - do NOT re-run @sentry/wizard) ──────────────────
# The SDK is installed and configured: sentry.server.config.ts,
# sentry.edge.config.ts, src/instrumentation.ts and
# src/instrumentation-client.ts, plus withSentryConfig in next.config.ts.
# Running the wizard would recreate sentry.client.config.ts, which was
# deliberately removed in 041de05 because it double-initialized the client
# SDK alongside instrumentation-client.ts.
#
# Without a DSN, Sentry.init() is a silent no-op - the app builds and runs
# but reports nothing, which looks identical to Sentry being uninstalled.
# Project settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time (Vercel / CI only). Omit locally: the build
# stays silent when SENTRY_AUTH_TOKEN is unset rather than failing.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Upstash Redis (rate limiting) ──────────────────────────────────────────
# Guards the chat and auth routes. When unset the limiter falls back to
# allowing requests, so set both in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Inngest (background jobs - nightly crawl, CSV upload processing) ──────
# Get both from the Inngest Cloud dashboard for this app ("scholarhub").
# Without INNGEST_EVENT_KEY, inngest.send() in src/app/api/cron/crawl and
# src/app/admin/actions.ts silently fails to deliver events. Without
# INNGEST_SIGNING_KEY, Inngest Cloud can't authenticate calls to
# /api/inngest, so dispatched events never actually run - set BOTH in every
# environment (Production and Preview), not just one.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── NVIDIA (LLM extraction for the CSV upload and nightly crawl pipelines) ─
# NVIDIA_API_KEY is used by both src/inngest/functions.ts (CSV upload) and
# src/inngest/crawler.ts (nightly crawl).
NVIDIA_API_KEY=
# Model used only by the nightly crawl (src/inngest/crawler.ts), kept
# separate from the CSV pipeline's model so each can be tuned
# independently. Defaults to meta/llama-3.3-70b-instruct if unset.
# meta/llama-3.2-90b-vision-instruct also accepts text-only prompts, so it
# works here without adding image/screenshot handling.
NVIDIA_CRAWL_MODEL=meta/llama-3.3-70b-instruct

# ── Brave Search API (search-based crawl discovery) ────────────────────────
# $5 per 1,000 requests, with $5 in free credits/month (api.search.brave.com)
# - requires a card on file, but our ~9 queries/night (~270/month, ~$1.35)
# stays within the free credit. Used by src/inngest/crawler.ts's
# search-discover step to find scholarship pages beyond the hardcoded
# DIRECTORIES/DIRECT_LINKS lists. Optional - discovery just skips this step
# and falls back to the directory scrapers if unset.
BRAVE_SEARCH_API_KEY=

# ── Consent manager ────────────────────────────────────────────────────────
# Salt for hashing visitor IPs in consent records - set a random value in
# production so hashes are not reversible across deployments.
CONSENT_IP_HASH_SALT=
# Overrides geo-detection in local testing only (e.g. DE to exercise the
# GDPR path). Leave unset in production.
CONSENT_TEST_COUNTRY=
