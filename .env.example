# ── ScholarHub Africa — environment template (copy to .env) ────────────────
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_hex(50))"

DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Local: leave blank to use SQLite. Production: Neon PostgreSQL URL.
DATABASE_URL=
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/scholarhub?sslmode=require

# Celery / Redis (Railway add-on). Local: leave blank (broker unused).
REDIS_URL=

# Email — Resend (production) or console backend (local)
RESEND_API_KEY=
DIGEST_EMAILS=royokola3@gmail.com
DEFAULT_FROM_EMAIL=ScholarHub Africa <digest@scholarhub.africa>

# Cloudflare R2 (production static assets) — optional
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Demo user password created by `python manage.py seed_demo`
DEMO_PASSWORD=change-me-roy-2026

# ── Marketing / SEO ──────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (empty = snippet not rendered in <head>)
GA4_MEASUREMENT_ID=
# Site identity used by the SEO context processor
SITE_DOMAIN=scholarhub.africa
COMPANY_PHONE=+254 700 123 456
COMPANY_ADDRESS=Westlands, Nairobi, Kenya
COMPANY_EMAIL=hello@scholarhub.africa
