# ── Consent Manager - environment template (copy to .env.local) ──────────────

# Comma-separated list of countries treated as the "CCPA / US state-law" region.
# Everything not in this list and not in the built-in GDPR list → region "none".
# Overrides the built-in GDPR/CCPA country tables from src/lib/consent/regions.ts
# (useful for testing: set CONSENT_TEST_COUNTRY=DE and restart the dev server).
CONSENT_TEST_COUNTRY=

# Admin credentials (demo auth - swap for your real IdP / NextAuth provider).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Token embedded in the admin session cookie; API routes verify it.
ADMIN_SESSION_TOKEN=dev-admin-token-change-me

# Salt used to HMAC-hash raw IPs before storage (compliance: pseudonymisation).
CONSENT_IP_HASH_SALT=dev-salt-change-me
